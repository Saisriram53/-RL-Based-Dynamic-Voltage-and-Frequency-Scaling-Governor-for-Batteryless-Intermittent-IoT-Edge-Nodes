// STM32F4 / ARM Cortex-M4 Platform Definition for DVFS Co-Simulation
sysbus:

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

nvic: NVIC.NVIC @ sysbus 0xE000E000
    sram: sram
    flash: flash

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00020000

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x00080000

usart1: UART.STM32F4_UART @ sysbus 0x40011000
    nvic: nvic
    IRQ: 37
