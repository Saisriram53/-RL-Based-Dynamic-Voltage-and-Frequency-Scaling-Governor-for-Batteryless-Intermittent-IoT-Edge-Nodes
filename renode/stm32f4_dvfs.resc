:name: STM32F4 ARM Cortex-M4 DVFS Co-Simulation
:description: Loads STM32F4 platform and binds USART1 to TCP Socket Terminal Port 4000

using sysbus
$name?="stm32f4_dvfs"

mach create $name
machine LoadPlatformDescription @renode/stm32f4_dvfs.repl

emulation CreateServerSocketTerminal 4000 "term"
connector Connect sysbus.usart1 term

start

echo "Renode STM32F4 ARM Cortex-M4 Target Initialized. Socket Server Terminal Listening on Port 4000."
