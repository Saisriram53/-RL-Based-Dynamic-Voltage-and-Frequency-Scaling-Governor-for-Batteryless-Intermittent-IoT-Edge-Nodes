:name: STM32F4 ARM Cortex-M4 DVFS Hardware Co-Simulation
:description: Loads custom STM32F4 platform description, ingests firmware ELF, and sets up USART1 serial terminal

using sysbus
$name?="stm32f4_dvfs"

mach create $name
machine LoadPlatformDescription @renode/stm32f4_dvfs.repl

sysbus LoadELF @firmware/firmware.elf

emulation CreateServerSocketTerminal 4000 "term"
connector Connect sysbus.usart1 term

start

echo "Renode STM32F4 ARM Cortex-M4 Target Initialized and Executing Firmware ELF."
